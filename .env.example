# ===========================================
# CyberShield Enterprise Configuration
# Copy this file to .env.local and fill in values
# ===========================================

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/cybershield?schema=public"

# Redis for caching and rate limiting (optional)
REDIS_URL="redis://localhost:6379"

# ===========================================
# AUTHENTICATION
# ===========================================
# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Session configuration
SESSION_MAX_AGE="28800" # 8 hours in seconds

# ===========================================
# OAUTH PROVIDERS (Optional)
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Azure AD (for enterprise SSO)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ===========================================
# AI SERVICES
# ===========================================
# Anthropic API for Claude
ANTHROPIC_API_KEY="your-anthropic-api-key"

# AI rate limiting
AI_RATE_LIMIT_REQUESTS="100"
AI_RATE_LIMIT_WINDOW="60000"

# ===========================================
# SECURITY
# ===========================================
# Password requirements
MIN_PASSWORD_LENGTH="12"
PASSWORD_REQUIRE_UPPERCASE="true"
PASSWORD_REQUIRE_LOWERCASE="true"
PASSWORD_REQUIRE_NUMBERS="true"
PASSWORD_REQUIRE_SPECIAL="true"

# Account lockout
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION="900000" # 15 minutes in ms

# MFA configuration
MFA_ISSUER="CyberShield Enterprise"

# ===========================================
# APPLICATION
# ===========================================
# App metadata
NEXT_PUBLIC_APP_NAME="CyberShield Enterprise"
NEXT_PUBLIC_APP_DESCRIPTION="Government-Grade Cybersecurity Training Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature flags
ENABLE_MFA="true"
ENABLE_OAUTH="true"
ENABLE_AUDIT_LOGGING="true"
ENABLE_THREAT_INTEL="true"

# ===========================================
# EMAIL (Optional)
# ===========================================
# SMTP configuration for notifications
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@cybershield.local"

# ===========================================
# STORAGE (Optional)
# ===========================================
# S3-compatible storage for file uploads
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""

# ===========================================
# MONITORING (Optional)
# ===========================================
# Sentry for error tracking
SENTRY_DSN=""

# Analytics
ANALYTICS_ID=""

# ===========================================
# LAB ENVIRONMENTS (Optional)
# ===========================================
# Docker configuration for labs
DOCKER_HOST=""
LAB_NETWORK_SUBNET="192.168.100.0/24"
LAB_MAX_CONCURRENT_USERS="50"
LAB_SESSION_TIMEOUT="180"

# ===========================================
# COMPLIANCE
# ===========================================
# Audit log retention (days)
AUDIT_LOG_RETENTION="365"

# Data retention policy (days)
DATA_RETENTION_PERIOD="2555" # 7 years

# ===========================================
# RATE LIMITING
# ===========================================
API_RATE_LIMIT_REQUESTS="100"
API_RATE_LIMIT_WINDOW="60000"
AUTH_RATE_LIMIT_REQUESTS="10"
AUTH_RATE_LIMIT_WINDOW="900000"
