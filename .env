# CyberShield Environment Variables
# Copy this file to .env.local and fill in your values

# Anthropic Claude API Key (Required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Database URL for persistent storage (Supabase recommended)
# DATABASE_URL=your_supabase_url_here
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Authentication (if implementing user accounts)
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_NAME=CyberShield
NEXT_PUBLIC_APP_VERSION=1.0.0
